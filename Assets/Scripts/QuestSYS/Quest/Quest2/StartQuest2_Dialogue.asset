  lines:
  - speaker: {fileID: 11400000, guid: 609fcc2495842074f85ce9b502e7f988, type: 2}
    text: "C\u1EE9u v\u1EDBi!!!!"
  - speaker: {fileID: 11400000, guid: 74ff79ffe05808b42b97eed64edc1a63, type: 2}
    text: "C\xF3 chuy\u1EC7n g\xEC v\u1EADy?"
  - speaker: {fileID: 11400000, guid: 609fcc2495842074f85ce9b502e7f988, type: 2}
    text: "Ph\xEDa tr\u01B0\u1EDBc c\xF3 qu\xE1i v\u1EADt, n\xF3 c\u01B0\u1EDBp xe
      h\xE0ng h\xF3a c\u1EE7a t\xF4i. May m\u1EAFn t\xF4i \u0111\xE3 tho\xE1t n\u1EA1n."
  - speaker: {fileID: 11400000, guid: 74ff79ffe05808b42b97eed64edc1a63, type: 2}
    text: "\u0110\u1EC3 t\xF4i."
