  lines:
  - speaker: {fileID: 11400000, guid: e16e4dc24771dd84a864600aafd1ce26, type: 2}
    text: "Ch\xE0o k\u1ECB s\u0129 \u0111\u1ECF!"
  - speaker: {fileID: 11400000, guid: e16e4dc24771dd84a864600aafd1ce26, type: 2}
    text: "Ch\xE0o m\u1EEBng ng\xE0i \u0111\u1EBFn v\u1EDBi ng\xF4i l\xE0ng!"
  - speaker: {fileID: 11400000, guid: e16e4dc24771dd84a864600aafd1ce26, type: 2}
    text: "\u0110\u1EC3 t\xF4i d\u1EABn \u0111\u01B0\u1EDDng cho ng\xE0i!"
  - speaker: {fileID: 11400000, guid: 74ff79ffe05808b42b97eed64edc1a63, type: 2}
    text: "C\u1EA3m \u01A1n nha!"
