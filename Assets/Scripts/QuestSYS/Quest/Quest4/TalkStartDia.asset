  lines:
  - speaker: {fileID: 11400000, guid: 876c65a99d3eb344c95eb7ac37bf355d, type: 2}
    text: "Xin ch\xE0o!"
  - speaker: {fileID: 11400000, guid: 74ff79ffe05808b42b97eed64edc1a63, type: 2}
    text: "Ch\xE0o!"
  - speaker: {fileID: 11400000, guid: 876c65a99d3eb344c95eb7ac37bf355d, type: 2}
    text: "T\xF4i l\xE0 Dien"
  - speaker: {fileID: 11400000, guid: 74ff79ffe05808b42b97eed64edc1a63, type: 2}
    text: "T\xF4i l\xE0 Red Knight! C\xF3 chuy\u1EC7n g\xEC v\u1EADy?"
  - speaker: {fileID: 11400000, guid: 1d95eb2cb98893f4aac48af4a001c2e5, type: 2}
    text: "Gi\xFAp t\xF4i \u0111\xE1nh b\u1EA1i qu\u1EF7 x\u01B0\u01A1ng "
  - speaker: {fileID: 11400000, guid: 74ff79ffe05808b42b97eed64edc1a63, type: 2}
